<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Serve an existing file directly if the request maps to one — covers
    # both the React build's assets/ and Symfony's own public/bundles/
    # (EasyAdmin's assets). Mirrors nginx/default.prod.conf's asset
    # location block, adapted to mod_rewrite.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # API go through Symfony's front controller.
    RewriteRule ^api/ %{ENV:BASE}/index.php [L]

    # EasyAdmin. CORRECTION (found while verifying admin login end-to-end):
    # despite the assumption baked into docker/nginx/default.prod.conf,
    # this EasyAdminBundle version does NOT put every CRUD screen behind
    # one query-string URL — #[AdminDashboard(routePath: '/admin')] plus
    # each AbstractCrudController generates a real path-based route per
    # entity (confirmed via `bin/console debug:router`): /admin/employee,
    # /admin/department, /admin/user, /admin/role, /admin/competency,
    # /admin/bsc-perspective, /admin/notification (+ their /new,
    # /{id}/edit, /autocomplete, etc. sub-paths). Only routing the bare
    # /admin, /admin/login, /admin/logout meant every other EasyAdmin
    # click — including the dashboard's own post-login redirect to
    # /admin/employee — fell through to the React shell below instead of
    # rendering the actual panel. Each entity slug is singular
    # (admin/user, admin/competency) while the SPA's own /admin/* client
    # routes are plural or distinct action words (admin/users,
    # admin/cycles, admin/competencies) — matched with a trailing
    # (/|$) boundary so e.g. ^admin/user never swallows admin/users.
    # IMPORTANT: every AbstractCrudController adds a new entity slug —
    # add its RewriteRule here too (`bin/console debug:router | grep
    # admin_.*_index` lists them all) or it silently falls through to
    # the React-shell catch-all below and renders the SPA's login page
    # instead of the admin panel (exactly what happened here — a full
    # EasyAdmin pass added 20 new controllers, discovered live).
    RewriteRule ^admin/?$ %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/login/?$ %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/logout/?$ %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/employee(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/department(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/user(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/role(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/competency(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/sub-competency(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/bsc-perspective(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/notification(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/appraisal-cycle(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/appraisal(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/key-deliverable(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/competency-rating(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/growth-plan(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/career-plan(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/development-need(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/training-need(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/strength-weakness(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/signature(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/comment(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/calibration-session(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/score-descriptor(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/bulk-import-job(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/appraisal-bulk-import-job(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/user-bulk-import-job(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/refresh-token(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/recovery-code(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/password-reset-token(/|$) %{ENV:BASE}/index.php [L]
    RewriteRule ^admin/audit-log(/|$) %{ENV:BASE}/index.php [L]

    # Everything else is a client-side SPA route (or a 404) — serve the
    # React shell and let client-side routing take over, instead of
    # falling through to Symfony's own router (which has no route for
    # e.g. /reports and would 404 first).
    RewriteRule ^ %{ENV:BASE}/index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
