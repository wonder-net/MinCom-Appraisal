# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# For native `symfony server:start` (no Docker): install MySQL locally via
# Homebrew (`brew install mysql`) — matches the containerized target below.
DATABASE_URL="mysql://mincom_symfony:!ChangeMe!@127.0.0.1:3306/mincom_appraisal_symfony?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ae01efc3ab9ca4819f179b2eb53a8fdcea80b3b42bc5e41a8beb6443eddf087b
# Access token lifetime, seconds. Mirrors Django's SESSION_IDLE_TIMEOUT_MINUTES (default 15 min).
JWT_ACCESS_TOKEN_TTL=900
# Refresh token lifetime, seconds. Mirrors Django's JWT_REFRESH_TOKEN_LIFETIME_DAYS (default 7 days).
JWT_REFRESH_TOKEN_TTL=604800
###< lexik/jwt-authentication-bundle ###

###> app/auth ###
# Absolute session timeout, hours. Mirrors Django's SESSION_ABSOLUTE_TIMEOUT_HOURS.
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Cloudflare Turnstile. Empty secret = CAPTCHA verification skipped (dev mode),
# mirrors TurnstileService.is_configured() in the Django app.
TURNSTILE_SECRET_KEY=
# Gates the `mfa_setup_required` flag in the login response.
MFA_REQUIRED=true
###< app/auth ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app/cache ###
# Backs cache.app (config/packages/cache.yaml) — ReportsCacheService,
# CycleListCache, and (transitively) the rate limiter's storage all live
# here. Generic localhost default so `composer install` / container
# compilation never fails for lack of the env var; test env reverts to
# the filesystem adapter regardless (no Redis service in CI), so this
# value is inert there. Point at a real host via .env.local/prod secrets
# wherever Redis isn't on localhost:6379.
REDIS_URL=redis://localhost:6379
###< app/cache ###

###> app/notifications ###
# Base URL of the frontend SPA, used to build in-app-notification/email
# deep links (mirrors Django's FRONTEND_URL setting).
FRONTEND_URL=http://localhost:5173
###< app/notifications ###

###> app/audit ###
# HMAC-SHA256 key signing each AuditLog entry's tamper-detection hash.
# Mirrors Django's AUDIT_HMAC_KEY. Dev-only value below; production
# MUST set a real hex-encoded secret via the environment.
AUDIT_HMAC_KEY=e7e927e17e929208cbc2361de6158dedcae17932d122b3b0dd9e204a9cf420fe
###< app/audit ###

###> app/encryption ###
# AES-256-GCM key (hex-encoded 32 bytes) for field-level encryption at
# rest, mirroring Django's FIELD_ENCRYPTION_KEY. Dev-only value below;
# production MUST set a real key via the environment. Generate one with:
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=65d9f447d28987836c7970841687a076586c8ad0d8c9cdd80e99cab88df7b820
###< app/encryption ###

###> symfony/mailer ###
# null://null discards mail silently (safe default for bare-metal local
# dev — no SMTP server assumed present). docker-compose.yml overrides
# this to smtp://mailpit:1025 (the bundled mailpit catcher) for the
# containerized dev flow. In production, point this at Postmark's SMTP
# relay — mirrors Django's PostmarkEmailBackend exactly, which is
# itself just Django's stock SMTP backend against smtp.postmarkapp.com
# (not the Postmark HTTP API), so no extra Composer package is needed
# here either — see .env.prod.local.dist.
MAILER_DSN=null://null
# Mirrors Django's DEFAULT_FROM_EMAIL.
MAILER_FROM_ADDRESS=noreply@mincom.com
# Mirrors Django's POSTMARK_MESSAGE_STREAM — injected into every
# outgoing message as the X-PM-Message-Stream header by
# PostmarkMessageStreamListener, harmless against non-Postmark
# transports (mailpit/null://null just ignore the extra header).
POSTMARK_MESSAGE_STREAM=outbound
###< symfony/mailer ###

###> sentry/sentry-symfony ###
# Empty = disabled (both the bundle and the underlying PHP SDK treat an
# empty DSN as "don't send anything" — see config/packages/sentry.yaml).
# Mirrors Django's SENTRY_DSN. Set to a real project DSN in production.
SENTRY_DSN=
# Mirrors Django's APP_VERSION passed as `release`. Optional — the SDK
# just omits the release tag on events if unset.
SENTRY_RELEASE=
###< sentry/sentry-symfony ###
