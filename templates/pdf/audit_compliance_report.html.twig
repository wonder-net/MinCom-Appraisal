{% extends "pdf/base_pdf.html.twig" %}

{% block title %}Audit Compliance Report — {{ cycle_name }} — {{ cycle_year }}{% endblock %}

{% block extra_styles %}
<style>
  .cover-page {
    text-align: center;
    padding-top: 4cm;
    padding-bottom: 2cm;
  }

  .cover-title {
    font-size: 20pt;
    font-weight: 700;
    color: #1a365d;
    margin-bottom: 0.5cm;
  }

  .cover-subtitle {
    font-size: 12pt;
    color: #4a5568;
    margin-bottom: 1.5cm;
  }

  .cover-meta {
    font-size: 9pt;
    color: #718096;
    line-height: 1.8;
  }

  .appraisal-block {
    margin-bottom: 0.6cm;
    padding: 0.3cm;
    border: 0.5pt solid #e2e8f0;
    page-break-inside: avoid;
  }

  .appraisal-header {
    font-size: 9pt;
    font-weight: 700;
    color: #1a365d;
    margin-bottom: 0.2cm;
    border-bottom: 0.5pt solid #cbd5e0;
    padding-bottom: 0.1cm;
  }

  .status-badge {
    display: inline-block;
    font-size: 7.5pt;
    font-weight: 700;
    padding: 0.05cm 0.15cm;
    border: 0.5pt solid #cbd5e0;
    color: #2d3748;
  }

  .summary-panel {
    border: 1pt solid #1a365d;
    padding: 0.3cm;
    margin-bottom: 0.5cm;
    background-color: #f7fafc;
  }

  .summary-panel table {
    margin-bottom: 0;
  }

  .summary-panel th {
    background-color: #1a365d;
    color: #ffffff;
  }

  .no-sigs {
    color: #a0aec0;
    font-style: italic;
    font-size: 8pt;
    padding: 0.1cm 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- ===== Cover Page ===== -->
<div class="cover-page">
  <div class="cover-title">Audit Compliance Report</div>
  <div class="cover-subtitle">Sign-Off Chain Verification</div>
  <div class="cover-meta">
    Cycle: {{ cycle_name }} ({{ cycle_year }})<br />
    Generated: {{ generated_at }}<br />
    Generated By: {{ generated_by }}
  </div>
</div>

<!-- ===== Summary Section ===== -->
<div class="page-break-before"></div>
<h2 class="section-title">Summary</h2>
<div class="summary-panel avoid-break">
  <table>
    <thead>
      <tr>
        <th style="width: 60%;">Metric</th>
        <th class="numeric" style="width: 40%;">Count</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Total Appraisals</td>
        <td class="numeric">{{ summary.total_count }}</td>
      </tr>
      {% for item in summary.by_status %}
      <tr>
        <td>{{ item.status }}</td>
        <td class="numeric">{{ item.count }}</td>
      </tr>
      {% endfor %}
      <tr>
        <td><strong>Disputes</strong></td>
        <td class="numeric"><strong>{{ summary.dispute_count }}</strong></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- ===== Per-Appraisal Sign-Off Chain ===== -->
<h2 class="section-title">Sign-Off Details</h2>
{% if appraisals %}
{% for appraisal in appraisals %}
<div class="appraisal-block">
  <div class="appraisal-header">
    {{ appraisal.employee_name }}
    {% if appraisal.department_name %} &mdash; {{ appraisal.department_name }}{% endif %}
    <span class="status-badge">{{ appraisal.status }}</span>
  </div>

  {% if appraisal.signatures %}
  <table>
    <thead>
      <tr>
        <th style="width: 22%;">Signer</th>
        <th style="width: 14%;">Role</th>
        <th style="width: 14%;">Action</th>
        <th style="width: 20%;">Date</th>
        <th style="width: 15%;">IP Address</th>
        <th style="width: 15%;">Reason</th>
      </tr>
    </thead>
    <tbody>
      {% for sig in appraisal.signatures %}
      <tr>
        <td>{{ sig.signer_name }}</td>
        <td>{{ sig.signer_role }}</td>
        <td>{{ sig.action }}</td>
        <td>{{ sig.signed_at }}</td>
        <td>{{ sig.ip_address }}</td>
        <td>{{ sig.reason|default('—') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="no-sigs">No signatures recorded.</p>
  {% endif %}
</div>
{% endfor %}
{% else %}
<p class="placeholder">No appraisals found for this cycle.</p>
{% endif %}
{% endblock %}
