{% extends "emails/base_email.html.twig" %}
{% block body %}
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Hello {{ recipient_name }},
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  We received a request to reset the password for your account (<code style="background-color: #edf2f7; padding: 2px 6px; border-radius: 3px; font-size: 13px;">{{ user_email }}</code>) on the MINCOM Employee Performance Appraisal Platform.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td align="center" style="padding: 0 0 24px 0;">
      <a href="{{ reset_url }}" style="display: inline-block; padding: 12px 32px; background-color: #1a365d; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 6px;">Reset Password</a>
    </td>
  </tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 16px 0;">
  <tr>
    <td style="padding: 16px; background-color: #fff5f5; border-radius: 6px; border: 1px solid #feb2b2;">
      <p style="margin: 0; font-size: 14px; color: #c53030;">
        <strong>This link expires in 1 hour.</strong> After that, you will need to request a new password reset.
      </p>
    </td>
  </tr>
</table>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  If you did not request a password reset, you can safely ignore this email. Your password will not be changed.
</p>
{% endblock body %}
