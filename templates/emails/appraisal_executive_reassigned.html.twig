{% extends "emails/base_email.html.twig" %}
{% block body %}
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Dear {{ recipient_name }},
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  HR has re-assigned a previously escalated appraisal to you. You are now the appraisor for <strong>{{ employee_name }}</strong>'s appraisal in the <strong>{{ cycle_period }}</strong> cycle, replacing the previously assigned Executive.
</p>
{% if escalation_reason %}
<p style="margin: 0 0 8px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  <strong>Original reason provided by HR Admin:</strong>
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 24px 0;">
  <tr>
    <td style="padding: 12px 16px; background-color: #f7fafc; border-left: 4px solid #1a365d; border-radius: 4px;">
      <p style="margin: 0; font-size: 14px; color: #2d3748; line-height: 1.6; white-space: pre-wrap;">{{ escalation_reason }}</p>
    </td>
  </tr>
</table>
{% endif %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td align="center" style="padding: 0 0 24px 0;">
      <a href="{{ appraisal_url }}" style="display: inline-block; padding: 12px 32px; background-color: #1a365d; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 6px;">View Appraisal</a>
    </td>
  </tr>
</table>
{% endblock body %}
