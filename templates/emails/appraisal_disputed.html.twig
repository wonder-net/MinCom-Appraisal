{% extends "emails/base_email.html.twig" %}
{% block body %}
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Dear {{ recipient_name }},
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  A dispute has been raised on {% if is_own_appraisal %}your{% else %}the{% endif %} performance appraisal {% if not is_own_appraisal %}for {{ employee_name }} {% endif %}for the <strong>{{ cycle_period }}</strong> cycle.
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  The appraisal sign-off has been disputed and is awaiting HR review. HR will return the appraisal to the discussion phase once the dispute has been reviewed.
</p>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Please review the appraisal details using the link below.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td align="center" style="padding: 0 0 24px 0;">
      <a href="{{ appraisal_url }}" style="display: inline-block; padding: 12px 32px; background-color: #1a365d; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 6px;">View Appraisal</a>
    </td>
  </tr>
</table>
{% endblock body %}
