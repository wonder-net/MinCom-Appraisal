{% extends "emails/base_email.html.twig" %}
{% block body %}
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Dear {{ recipient_name }},
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  {{ employee_name }} has submitted their self-assessment for the <strong>{{ cycle_period }}</strong> appraisal cycle and it is now ready for your review.
</p>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Please review the self-assessment and provide your manager ratings at your earliest convenience.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td align="center" style="padding: 0 0 24px 0;">
      <a href="{{ appraisal_url }}" style="display: inline-block; padding: 12px 32px; background-color: #1a365d; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 6px;">Review Appraisal</a>
    </td>
  </tr>
</table>
{% endblock body %}
