{% extends "emails/base_email.html.twig" %}
{% block body %}
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Dear {{ recipient_name }},
</p>
<p style="margin: 0 0 16px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Your account on the MINCOM Employee Performance Appraisal Platform has been created.
</p>
<p style="margin: 0 0 8px 0; font-size: 15px; color: #2d3748; line-height: 1.6;">
  Please log in using the following credentials and change your password immediately:
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 16px 0;">
  <tr>
    <td style="padding: 16px; background-color: #f7fafc; border-radius: 6px; border: 1px solid #e2e8f0;">
      <p style="margin: 0 0 8px 0; font-size: 14px; color: #4a5568;">
        <strong>Email:</strong> {{ user_email }}
      </p>
      <p style="margin: 0; font-size: 14px; color: #4a5568;">
        <strong>Temporary Password:</strong> <code style="background-color: #edf2f7; padding: 2px 6px; border-radius: 3px; font-size: 14px;">{{ temp_password }}</code>
      </p>
    </td>
  </tr>
</table>
<p style="margin: 0 0 24px 0; font-size: 13px; color: #718096; line-height: 1.5;">
  This temporary password expires in 72 hours. You will be required to set a new password on first login.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td align="center" style="padding: 0 0 24px 0;">
      <a href="{{ login_url }}" style="display: inline-block; padding: 12px 32px; background-color: #1a365d; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 6px;">Log In Now</a>
    </td>
  </tr>
</table>
{% endblock body %}
