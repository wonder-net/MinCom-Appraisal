# symfony-backend/.env.prod.local.dist — template for the real production
# secrets file. Copy this to `.env.prod.local` on the VM, fill in every
# value, and never commit the filled-in copy (docker-compose.prod.yml
# loads it via `env_file:`, never bakes it into the image).
#
# This same file is also the `db` container's env_file in
# docker-compose.prod.yml — MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD
# below are consumed by both the app (via DATABASE_URL) and the MySQL
# container itself, so they MUST stay in sync with each other.
#
# App\Service\ProductionConfigValidator (runs on every boot when
# APP_ENV=prod) refuses to start if any of APP_SECRET/TURNSTILE_SECRET_KEY
# are blank, if AUDIT_HMAC_KEY/FIELD_ENCRYPTION_KEY/JWT_PASSPHRASE still
# match the dev-only placeholders committed in `.env`, or if DATABASE_URL
# still contains "devpassword" — a misconfigured deploy fails loudly on
# first request/command instead of silently running insecure.

APP_ENV=prod

# Generate: openssl rand -hex 32
APP_SECRET=

# ----- Database (MySQL) -----------------------------------------------------
# MYSQL_* are read directly by the bundled `db` service (docker-compose.prod.yml);
# DATABASE_URL must reference the SAME user/password/database — Symfony
# doesn't cross-reference the two automatically, this file is the single
# source both are copied from.
MYSQL_DATABASE=mincom_appraisal_symfony
MYSQL_USER=mincom_symfony
# Generate: openssl rand -hex 24
MYSQL_PASSWORD=
# Only needed if you ever need root access inside the `db` container
# (e.g. manual `mysql -u root`) — the app itself connects as MYSQL_USER.
# Generate: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
# Keep the user/password segments identical to MYSQL_USER/MYSQL_PASSWORD
# above. `db` is this file's own bundled MySQL service (Docker's internal
# DNS resolves the service name) — point at an external host:port instead
# if you deleted that service per docker-compose.prod.yml's own comment.
DATABASE_URL="mysql://mincom_symfony:REPLACE_WITH_MYSQL_PASSWORD@db:3306/mincom_appraisal_symfony?serverVersion=8.0.32&charset=utf8mb4"

# ----- JWT auth ---------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_PASSPHRASE=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# ----- Session / bot protection -----------------------------------------
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Cloudflare Turnstile secret key (dashboard.cloudflare.com -> Turnstile).
# Must be non-empty in prod — CAPTCHA verification is skipped entirely
# otherwise (see TurnstileService::isConfigured()).
TURNSTILE_SECRET_KEY=
MFA_REQUIRED=true

# ----- Redis (cache.app / rate limiter / Messenger transport) ----------
# `redis` is this file's own bundled Redis service — point at an external
# host:port instead if you deleted that service.
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# ----- Frontend ----------------------------------------------------------
# The real production domain the SPA is served from — used to build
# in-app-notification/email deep links.
FRONTEND_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN

# ----- Email (Postmark SMTP relay) ---------------------------------------
# Same shape as Django's PostmarkEmailBackend — Postmark's stock SMTP
# relay, not their HTTP API, so no extra Composer package is needed.
# Server API token doubles as both SMTP username and password.
MAILER_DSN=smtp://REPLACE_WITH_POSTMARK_TOKEN:REPLACE_WITH_POSTMARK_TOKEN@smtp.postmarkapp.com:587
MAILER_FROM_ADDRESS=noreply@REPLACE_WITH_PRODUCTION_DOMAIN
POSTMARK_MESSAGE_STREAM=outbound

# ----- Field-level encryption / audit trail ------------------------------
# HMAC-SHA256 key signing each AuditLog entry's tamper-detection hash.
# Generate: openssl rand -hex 32
AUDIT_HMAC_KEY=
# AES-256-GCM key (hex-encoded 32 bytes) for field-level encryption at rest.
# Generate: openssl rand -hex 32
# WARNING: rotating this after real data exists makes every previously
# encrypted field unreadable — there is no re-encryption tool yet. Set it
# once, back it up somewhere durable outside this file.
FIELD_ENCRYPTION_KEY=

# ----- Error monitoring ---------------------------------------------------
# Real Sentry project DSN. Blank = disabled (no events sent, not an error).
SENTRY_DSN=
# Mirrors Django's APP_VERSION passed as `release` — optional, omit the
# release tag on events if unset. A git SHA or app version string works.
SENTRY_RELEASE=
